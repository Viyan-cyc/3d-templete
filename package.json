{
  "name": "3d-templete",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --fix --max-warnings 0 --no-warn-ignored"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "gsap": "^3.15.0",
    "three": "^0.185.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.11",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "//dependencies-note": "@cyc/3d-components 本身在 dev 阶段用 vite alias 直引 ../3d-components/src，无需 npm install；生产阶段改 dependencies 加 @cyc/3d-components 并移除 vite alias。gsap/three-bvh-csg/three-mesh-bvh 是 @cyc/3d-components 的 peerDep（Grid/Wall 组件用到）。",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.5"
  }
}
